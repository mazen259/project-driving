# Copy this file to backend/.env and fill in the values.
# main.py loads backend/.env automatically before any other module.

# ---- Groq model settings ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Retrieval backend ----
# tfidf       -> default behavior, fast and local, no model download.
# embeddings  -> uses sentence-transformers, downloads weights once,
#                and caches chunk embeddings on disk so restarts
#                do not recompute embeddings every time.
RETRIEVAL_BACKEND=embeddings

# When RETRIEVAL_BACKEND is set to embeddings, these settings apply:
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_CACHE_DIR=app/.cache

# Leave false normally. Set to true once only to force
# recomputing embeddings manually if needed.
# Changes in data/all_data.txt automatically invalidate the cache.
FORCE_REEMBED=false
