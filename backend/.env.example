# انسخ الملف ده لاسم .env في نفس المجلد ده (backend/.env) واملأ القيم.
# main.py بيعمل load_dotenv لملف backend/.env تلقائيًا قبل أي حاجة تانية.

# ---- الموديل اللي بيرد على المستخدم (Groq) ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- محرك البحث (retrieval) ----
# tfidf       -> السلوك الحالي، سريع ومحلي 100%، مفيش تحميل موديل.
# embeddings  -> بيستخدم sentence-transformers، بيحتاج إنترنت أول مرة بس
#                عشان ينزل وزن الموديل، وبعدين بيتخزن الـ embeddings في
#                كاش على الديسك فمش بيعيد الحساب كل مرة تشغّل السيرفر.
RETRIEVAL_BACKEND=tfidf

# لو غيّرت RETRIEVAL_BACKEND لـ embeddings، الإعدادات دي بتتفعل:
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_CACHE_DIR=app/.cache

# خليها false عادي. غيّرها لـ true مرة واحدة بس لو عاوز تجبر السيستم
# يعيد حساب الـ embeddings من الأول يدويًا (مش لازم عادي، لأن أي تعديل
# فعلي في data/all_data.txt بيخلي الكاش يتجاهل نفسه تلقائيًا).
FORCE_REEMBED=false

# ---- تحويل الصوت لنص (faster-whisper) لـ /api/chat/voice ----
# tiny/base/small -> أسرع وأخف (مناسبة لتجربة أو سيرفر بإمكانيات محدودة).
# medium/large-v3 -> أدق (خصوصًا مع اللهجة المصرية) بس أبطأ وأتقل.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# اللغة المتوقعة للصوت. سيبها فاضية لو عايز الموديل يكتشف اللغة تلقائيًا.
WHISPER_LANGUAGE=ar
